    {
      "type": "bargauge",
      "title": "Etapas com falha",
      "description": "Ranking de tarefas que exigem atenção da equipe de plataforma.",
      "id": 51,
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (span_name) (traces_span_metrics_calls_total{span_name=~\\\"TASK .*\\\",status_code=\\\"STATUS_CODE_ERROR\\\"})", "refId": "A" }],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] } }, "overrides": [] }
    },
    {
      "type": "logs",
      "title": "Eventos de erro recentes",
      "description": "Logs OTEL correlacionados por trace ID; abra o trace correspondente no Tempo para detalhar jobs e steps.",
      "id": 52,
      "gridPos": { "h": 9, "w": 14, "x": 10, "y": 41 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=\\\"github-actions-workflow-telemetry\\\",severity_text=\\\"ERROR\\\"}", "refId": "A" }],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyJSON": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Saúde operacional e SLO",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 },
      "id": 60,
      "panels": []
    },
    {
      "type": "stat",
      "title": "p95 da esteira",
      "description": "95% das execuções devem terminar abaixo deste tempo. Alvo demonstrativo: 60 s.",
      "id": 61,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (traces_span_metrics_duration_milliseconds_bucket{span_name=~\"RUN .*\"}))", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 45000 }, { "color": "red", "value": 60000 }] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "SLO de entrega",
      "description": "Percentual de execuções bem-sucedidas. Meta corporativa: 95%.",
      "id": 62,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * sum(traces_span_metrics_calls_total{span_name=~\"RUN .*\",status_code=\"STATUS_CODE_OK\"}) / sum(traces_span_metrics_calls_total{span_name=~\"RUN .*\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 80 }, { "color": "green", "value": 95 }] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Falhas acumuladas",
      "description": "Execuções que exigiram investigação desde a inicialização do Collector.",
      "id": 63,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(traces_span_metrics_calls_total{span_name=~\"RUN .*\",status_code=\"STATUS_CODE_ERROR\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "type": "text",
      "title": "Runbook de resposta",
      "id": 64,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 52 },
      "options": {
        "mode": "markdown",
        "content": "### Quando houver falha\n\n1. Localize a etapa vermelha.\n2. Abra o evento no Loki e copie o `trace_id`.\n3. Pesquise o trace no Tempo.\n4. Use a URL do job para atuar no GitHub Actions.\n\n**SLO alvo:** sucesso ≥ 95% · p95 < 60 s"
      }
    },
    {
      "type": "timeseries",
      "title": "Cadência de execuções por resultado",
      "description": "Incrementos de sucesso e falha por intervalo; evidencia regressões e incidentes recorrentes.",
      "id": 65,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(traces_span_metrics_calls_total{span_name=~\"RUN .*\",status_code=\"STATUS_CODE_OK\"}[$__rate_interval]))", "legendFormat": "Sucessos", "refId": "A" },
        { "expr": "sum(increase(traces_span_metrics_calls_total{span_name=~\"RUN .*\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))", "legendFormat": "Falhas", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 55, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Resultado por workflow",
      "description": "Permite comparar a saúde das esteiras quando novos workflows forem incorporados à plataforma.",
      "id": 66,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (cicd_pipeline_name, cicd_pipeline_result) (traces_span_metrics_calls_total{span_name=~\"RUN .*\"})", "legendFormat": "{{cicd_pipeline_name}} · {{cicd_pipeline_result}}", "refId": "A" }],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*failure.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*success.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    }
  ],
